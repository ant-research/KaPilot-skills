{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(cargo kani *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)"
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  }
}
